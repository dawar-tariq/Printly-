# Copy to .env.local (gitignored) and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, bypasses RLS
# Canonical origin only; use your real HTTPS production origin, with no path or query.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Non-Vercel production only: set to 1 ONLY after a trusted reverse proxy
# strips and overwrites X-Printly-Client-IP with exactly one client IP and
# blocks direct server access. Ordinary X-Forwarded-For is not used.
# Leave unset on Vercel and in local development; see README.
# PRINTLY_TRUST_PROXY_IP=1
# Optional: enable Dropbox Chooser button in upload step (otherwise "paste a Dropbox link" still works)
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Optional server-only Upstash Redis REST cache for authenticated shop QR
# artwork. Leave BOTH unset to render locally. Never use NEXT_PUBLIC_ here.
# The service-role key also signs cache entries; no orders or contacts are cached.
PRINTLY_REDIS_REST_URL=
PRINTLY_REDIS_REST_TOKEN=

# Optional native owner-app presentation settings. Changes require a server
# rollout, but no app reinstall; no HTML, links, access rules or prices.
PRINTLY_NATIVE_NOTICE=
PRINTLY_NATIVE_HOME_SUBTITLE=
PRINTLY_NATIVE_BOARD_REFRESH_SECONDS=15
