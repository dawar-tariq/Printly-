# Copy to .env.local (gitignored) and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, bypasses RLS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enable Dropbox Chooser button in upload step (otherwise "paste a Dropbox link" still works)
NEXT_PUBLIC_DROPBOX_APP_KEY=
